{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "product": {
      "type": "string",
      "enum": [
        "auto",
        "synergy",
        "globe"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "live",
        "cache",
        "unconfigured"
      ]
    },
    "loadedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "metadataUrl": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "setName": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "nullable": {
                  "type": "boolean"
                },
                "maxLength": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "name",
                "type",
                "nullable"
              ],
              "additionalProperties": false
            }
          },
          "readable": {
            "type": "boolean"
          },
          "writable": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "setName",
          "namespace",
          "keys",
          "properties",
          "readable",
          "writable"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST"
            ]
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "nullable": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "type",
                "nullable"
              ],
              "additionalProperties": false
            }
          },
          "returnType": {
            "type": "string"
          },
          "public": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "namespace",
          "method",
          "parameters",
          "public"
        ],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "detected",
          "verified",
          "restricted",
          "unavailable"
        ]
      }
    }
  },
  "required": [
    "product",
    "source",
    "loadedAt",
    "entities",
    "actions",
    "capabilities"
  ],
  "additionalProperties": false
}
