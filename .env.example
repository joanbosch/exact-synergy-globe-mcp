# One process connects to one Exact Entity Services API root.
EXACT_API_BASE_URL=https://exact.example.test/services/Exact.Entity.REST.svc/
EXACT_API_KIND=auto
EXACT_API_AUTH=ntlm

# NTLM fields. Never commit real values.
EXACT_API_DOMAIN=EXAMPLE
EXACT_API_DB_SERVER=SQLSERVER
EXACT_API_DB_NAME=ADMINISTRATION
EXACT_API_USERNAME=mcp-reader
EXACT_API_PASSWORD=replace-through-secret-store

# OAuth alternative (omit NTLM-only fields when selected).
# EXACT_API_ACCESS_TOKEN=replace-through-secret-store
# EXACT_API_ACCESS_TOKEN_TYPE=Bearer

# Deny writes by default.
EXACT_READ_ONLY=true
EXACT_ALLOWED_ENTITIES=Account,Resource,Request
# EXACT_ALLOWED_ACTIONS=RequestFlowApprove
EXACT_ALLOW_CREATE=false
EXACT_ALLOW_UPDATE=false
EXACT_ALLOW_DELETE=false
EXACT_ALLOW_EXECUTE_ACTION=false

EXACT_REQUEST_TIMEOUT_MS=30000
EXACT_MAX_PAGE_SIZE=100
EXACT_MAX_RESPONSE_BYTES=5000000
EXACT_MAX_CONTINUATION_PAGES=10
EXACT_LOG_LEVEL=info
# EXACT_METADATA_CACHE_PATH=/absolute/private/path/exact-metadata.json
